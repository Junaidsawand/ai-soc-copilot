# ==========================================
# AI SOC Copilot - Environment Configuration
# ==========================================

# ------------------------------------------
# Application Configuration
# ------------------------------------------
ENVIRONMENT=development
# Acceptable values: development, staging, production

LOG_LEVEL=INFO
# Acceptable values: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Maximum allowed size for uploaded JSON alerts in Megabytes
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------
# Security Configuration
# ------------------------------------------
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:*

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# These credentials are used by the Docker Compose PostgreSQL container
POSTGRES_USER=aisoc_admin
POSTGRES_PASSWORD=changeme_local
POSTGRES_DB=aisoc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# The connection string used by FastAPI/SQLAlchemy (Note: using 'db' as host inside docker network)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------
# AI Provider Configuration (OpenAI)
# ------------------------------------------
# Your OpenAI API key required for the AI Orchestrator
OPENAI_API_KEY=sk-proj-placeholder-insert-your-key-here
